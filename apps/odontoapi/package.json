{
  "name": "@odontoehtec/odontoapi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm prisma:generate && nest build",
    "start": "node dist/main",
    "start:prod": "pnpm build && node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "type-check": "pnpm prisma:generate && tsc --noEmit --project tsconfig.typecheck.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "db:setup": "pnpm prisma:generate && pnpm prisma:migrate:dev",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^8.1.0",
    "@odontoehtec/shared": "workspace:*",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.4.1",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "*"
  }
}
